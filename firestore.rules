rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function isAdmin() {
   return signedIn()
    && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
  }
  function isActiveStudent() {
   return signedIn()
    && exists(/databases/$(database)/documents/Students/$(request.auth.uid))
    && get(/databases/$(database)/documents/Students/$(request.auth.uid)).data.active == true
    && get(/databases/$(database)/documents/Students/$(request.auth.uid)).data.role == 'student'
    && get(/databases/$(database)/documents/Students/$(request.auth.uid)).data.get('mustChangePassword', false) == false;
  }
  match /admins/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /Students/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
   allow list: if isAdmin();
   allow create: if isAdmin()
    && request.resource.data.keys().hasOnly(['name','role','active'])
    && request.resource.data.role == 'student'
    && request.resource.data.active is bool
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.name.size() <= 100;
   allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','active'])
    && request.resource.data.active is bool
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.name.size() <= 100;
   allow delete: if false;
  }
  match /courseCatalog/{courseId} {
   allow read: if isAdmin() || isActiveStudent();
   allow create, update: if isAdmin()
    && courseId == 'batch1'
    && request.resource.data.keys().hasOnly(['modules'])
    && request.resource.data.modules is list
    && request.resource.data.modules.size() <= 50;
   allow delete: if false;
  }
  match /privateVideoMap/{documentId} { allow read, write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
